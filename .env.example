# AgriChain Connect Environment Configuration Template
PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

INSFORGE_URL=https://your-project.insforge.app
INSFORGE_ANON_KEY=your-anon-key
INSFORGE_API_KEY=your-api-key

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

PAYMENT_GATEWAY_PROVIDER=simulated
PAYMENT_GATEWAY_KEY_ID=your_key_id
PAYMENT_GATEWAY_KEY_SECRET=your_key_secret
ESCROW_INSPECTION_WINDOW_HOURS=48

MARKET_DATA_PROVIDER=internal_mandi_index
MARKET_DATA_API_KEY=your_market_api_key
MARKET_DATA_API_URL=https://api.data.gov.in/resource/...

DEFAULT_SEARCH_RADIUS_KM=10
EXPANSION_STEPS_KM=10,25,50,100,200
